# ============================================================================
# FitProIA - Configuración de Variables de Entorno (Vercel + Supabase + Local)
# ============================================================================

# --- Base de Datos (Supabase PostgreSQL en producción / SQLite en local por defecto) ---
# Ejemplo Supabase (Transaction Pooler / Direct):
# DATABASE_URL="postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="sqlite:///./fitproia.db"

# --- Supabase Client & Storage (Para Auth / S3 Bucket de fotos de platos y progreso) ---
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-supabase-anon-key"
SUPABASE_ANON_KEY="tu-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="tu-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="fitproia-media"

# --- Autenticación real (producción: true) y CORS (URL de Vercel) ---
REQUIRE_AUTH="false"
CORS_ORIGINS="*"

# --- Seguridad y Sesiones Persistentes PWA (Ley 1581 Habeas Data) ---
JWT_SECRET_KEY="cambia-esta-clave-secreta-en-produccion-32-bytes-min"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=90

# --- Inteligencia Artificial (Fase 2+: Google Gemini API Multimodal) ---
GEMINI_API_KEY="tu-google-gemini-api-key"
GEMINI_VISION_MODEL="gemini-2.5-flash"

# --- URL del Backend para el Frontend PWA (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_APP_NAME="FitProIA"
